	<div class="footer-bottom">
		<p class="copyright">&copy; {today.getFullYear()} Rainiee. All rights reserved.</p>
		<div class="footer-legal">
			<a href="/privacy">Privacy Policy</a>
			<span class="separator">•</span>
			<a href="/sitemap-index.xml">Sitemap</a>
			<span class="separator">•</span>
			<a href="/rss.xml">RSS Feed</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding: 3rem 1.5rem 2rem;
		background: rgb(var(--surface));
		border-top: 1px solid var(--border);
	}

	.footer-inner {
		width: min(var(--page-max), 100%);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.5fr 2fr;
		gap: 3rem;
		margin-bottom: 2rem;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.footer-title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
		color: rgb(var(--ink));
	}

	.logo-dot {
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-warm) 100%);
		box-shadow: 0 0 0 3px rgba(var(--accent-soft), 0.9);
	}

	.footer-copy {
		margin: 0;
		max-width: 34ch;
		color: rgb(var(--ink-soft));
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.footer-sections {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.footer-section-title {
		margin: 0 0 0.9rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(var(--ink-soft));
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.footer-links a {
		font-size: 0.95rem;
		color: rgb(var(--ink-soft));
		transition: color 0.2s var(--ease-out);
	}

	.footer-links a:hover {
		color: var(--accent-strong);
	}

	.social-links {
		display: flex;
		gap: 0.4rem;
	}

	.icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		border: 1px solid var(--border);
		color: rgb(var(--ink-soft));
		transition:
			color 0.2s var(--ease-out),
			background 0.2s var(--ease-out),
			border-color 0.2s var(--ease-out);
	}

	.icon-link:hover {
		color: var(--accent-strong);
		background: rgba(var(--accent-soft), 0.8);
		border-color: rgba(79, 70, 229, 0.25);
	}

	.footer-bottom {
		width: min(var(--page-max), 100%);
		margin: 0 auto;
		padding-top: 1.6rem;
		border-top: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.copyright {
		margin: 0;
		color: rgb(var(--ink-soft));
		font-size: 0.88rem;
	}

	.footer-legal {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.footer-legal a {
		color: rgb(var(--ink-soft));
		font-size: 0.88rem;
	}

	.footer-legal a:hover {
		color: var(--accent-strong);
	}

	.separator {
		color: rgb(var(--ink-soft));
		opacity: 0.5;
	}

	@media (max-width: 900px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-sections {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}

	@media (max-width: 600px) {
		.footer-sections {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
