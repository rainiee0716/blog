---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="nav">
		<div class="brand">
			<a class="logo" href="/">
				<span class="logo-dot" aria-hidden="true"></span>
				Rainiee
			</a>
			<span class="tagline">Career & AI Notes</span>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/privacy">Privacy</HeaderLink>
		</div>
		<div class="social-links">
			<a
				class="icon-link"
				href="https://github.com/rainiee"
				target="_blank"
				rel="noreferrer"
				aria-label="GitHub"
			>
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
					></path>
				</svg>
			</a>
			<a
				class="icon-link"
				href="https://twitter.com/rainee0716"
				target="_blank"
				rel="noreferrer"
				aria-label="Twitter"
			>
				<span class="sr-only">Twitter</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M19.5 7.5c.01.14.01.29.01.44 0 4.5-3.43 9.7-9.7 9.7-1.93 0-3.72-.56-5.23-1.52.27.03.54.04.82.04 1.6 0 3.07-.55 4.25-1.46a3.42 3.42 0 0 1-3.19-2.38c.2.03.4.05.62.05.3 0 .6-.04.88-.12a3.42 3.42 0 0 1-2.74-3.35v-.04c.46.26.99.42 1.56.44a3.42 3.42 0 0 1-1.06-4.56 9.72 9.72 0 0 0 7.06 3.58 3.86 3.86 0 0 1-.09-.78 3.42 3.42 0 0 1 5.91-2.34 6.73 6.73 0 0 0 2.17-.83 3.41 3.41 0 0 1-1.5 1.89 6.78 6.78 0 0 0 1.96-.53 7.35 7.35 0 0 1-1.7 1.77z"
					></path>
				</svg>
			</a>
			<a class="icon-link" href="mailto:rainee0716@gmail.com" aria-label="Email">
				<span class="sr-only">Email</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
					<path
						fill="currentColor"
						d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm0 2v.2l8 4.8 8-4.8V7H4zm16 10V9.3l-7.47 4.48a1 1 0 0 1-1.06 0L4 9.3V17h16z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(248, 250, 252, 0.82);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin: 0 auto;
		padding: 0.75rem 1.4rem;
		width: min(var(--page-max), 100%);
	}

	.brand {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: rgb(var(--ink));
	}

	.logo:hover {
		color: var(--accent-strong);
	}

	.logo-dot {
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-warm) 100%);
		box-shadow: 0 0 0 3px rgba(var(--accent-soft), 0.9);
	}

	.tagline {
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(var(--ink-soft));
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.internal-links a {
		padding: 0.4rem 0.75rem;
		border-radius: 8px;
		color: rgb(var(--ink-soft));
		font-weight: 600;
		font-size: 0.95rem;
		transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
	}

	.internal-links a:hover {
		color: rgb(var(--ink));
	}

	.internal-links a.active {
		background: rgba(var(--accent-soft), 0.9);
		color: var(--accent-strong);
	}

	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: rgb(var(--ink-soft));
	}

	.icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 8px;
		border: 1px solid transparent;
		color: rgb(var(--ink-soft));
		transition:
			color 0.2s var(--ease-out),
			background 0.2s var(--ease-out),
			border-color 0.2s var(--ease-out);
	}

	.icon-link:hover {
		color: var(--accent-strong);
		background: rgba(var(--accent-soft), 0.8);
		border-color: rgba(79, 70, 229, 0.2);
	}

	@media (max-width: 900px) {
		.nav {
			flex-wrap: wrap;
			justify-content: center;
		}

		.brand {
			align-items: center;
		}
	}

	@media (max-width: 720px) {
		.tagline {
			display: none;
		}

		.social-links {
			display: none;
		}
	}
</style>
