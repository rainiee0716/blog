---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description="All posts on AI workflows, career growth, and productivity — from real-world experience." />
		<style>
			.blog-hero {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				margin-bottom: 2.5rem;
			}
			.category-filter {
				margin-bottom: 2rem;
			}
			.category-filter-text {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				color: rgb(var(--ink-soft));
				font-size: 0.95rem;
			}
			.category-filter-text a {
				color: var(--accent-strong);
				font-weight: 600;
			}
			.post-grid {
				list-style: none;
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.5rem;
				margin: 0;
				padding: 0;
			}
			.post-card {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				background: rgb(var(--surface));
				border-radius: var(--radius-lg);
				border: 1px solid var(--border);
				padding: 1.4rem;
				box-shadow: var(--shadow-sm);
				transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow);
				border-color: var(--border-strong);
			}
			.post-card img {
				box-shadow: none;
				width: 100%;
				height: auto;
				object-fit: cover;
				aspect-ratio: 16/9;
				border-radius: var(--radius);
			}
			.post-card-body {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				flex: 1;
			}
			.post-title {
				margin: 0;
				font-size: 1.15rem;
				line-height: 1.35;
				color: rgb(var(--ink));
			}
			.post-card-desc {
				color: rgb(var(--ink-soft));
				font-size: 0.9rem;
				line-height: 1.6;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-meta {
				color: rgb(var(--ink-soft));
				font-size: 0.82rem;
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin: 0;
			}
			.post-category {
				display: inline-block;
				padding: 0.18rem 0.6rem;
				background: rgba(var(--accent-soft), 0.9);
				color: var(--accent-strong);
				border-radius: 999px;
				font-size: 0.76rem;
				font-weight: 600;
				letter-spacing: 0.01em;
			}
			.post-link {
				display: flex;
				flex-direction: column;
				gap: 0.8rem;
				color: inherit;
				flex: 1;
			}
			@media (max-width: 1000px) {
				.post-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 720px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-hero reveal">
				<p class="eyebrow">All posts</p>
				<h1>Career & AI, in practice</h1>
				<p class="lead">Methodologies, tool reviews, and retrospectives from real projects.</p>
			</section>
			<section class="category-filter" id="category-filter" hidden>
				<p class="category-filter-text">
					<span id="category-filter-label"></span>
					<a id="category-filter-clear" href=""></a>
				</p>
			</section>
			<section>
				<ul class="post-grid">
					{
						posts.map((post, index) => (
							<li class="post-card reveal" data-category={post.data.category ?? ''} style={`--delay: ${Math.min(index, 8) * 60}ms;`}>
								<a class="post-link" href={`/blog/${post.id}/`}>
									<div class="post-card-body">
										{post.data.category && <span class="post-category">{post.data.category}</span>}
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-card-desc">{post.data.description}</p>
										<p class="post-meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			const category = new URLSearchParams(window.location.search).get('category');
			if (category) {
				const cards = document.querySelectorAll('.post-card');
				let visible = 0;
				cards.forEach((card) => {
					const match = card.dataset.category === category;
					card.style.display = match ? '' : 'none';
					if (match) visible += 1;
				});
				const banner = document.getElementById('category-filter');
				const label = document.getElementById('category-filter-label');
				const clear = document.getElementById('category-filter-clear');
				if (banner && label && clear) {
					label.textContent =
						visible > 0 ? `Category: ${category}` : `No posts in "${category}" yet`;
					clear.textContent = 'View all';
					clear.href = window.location.pathname;
					banner.hidden = false;
				}
			}
		</script>
	</body>
</html>
